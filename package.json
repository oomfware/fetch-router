{
	"name": "@oomfware/fetch-router",
	"version": "0.2.1",
	"description": "composable web router",
	"license": "0BSD",
	"repository": {
		"type": "git",
		"url": "https://codeberg.org/oomfware/fetch-router"
	},
	"files": [
		"dist/",
		"src/",
		"!src/**/*.bench.ts",
		"!src/**/*.test.ts"
	],
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": "./dist/index.mjs",
		"./middlewares/async-context": "./dist/middlewares/async-context.mjs",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"fmt": "oxfmt",
		"lint": "oxlint",
		"prepublishOnly": "pnpm run build"
	},
	"dependencies": {
		"@remix-run/route-pattern": "^0.20.0"
	},
	"devDependencies": {
		"@types/bun": "^1.3.11",
		"bumpp": "^11.0.1",
		"oxfmt": "^0.43.0",
		"oxlint": "^1.58.0",
		"oxlint-tsgolint": "^0.19.0",
		"tsdown": "^0.21.7",
		"typescript": "^6.0.2"
	}
}
